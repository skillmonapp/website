---
import Layout from "../layouts/Layout.astro";
import skillmonLogo from "../assets/skillmon.svg";
---

<Layout>
  <main>
    <div>
      <img class="mark" src={skillmonLogo.src} alt="" />
    </div>
    <div>
      <div class="wordmark">skillmon</div>
      <div class="status">
        <span class="dot"></span><span class="overline">Coming soon</span>
      </div>
    </div>
    <p class="lede">
      A desktop companion for <strong>EVE Online</strong> skill queues.
    </p>
  </main>
</Layout>

<style>
  .status {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    margin-top: 14px;
  }

  .dot {
    width: 6px;
    height: 6px;
    border-radius: var(--radius-pill);
    background: var(--status-training);
    box-shadow: 0 0 0 3px var(--status-training-soft);
  }

  .overline {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    font-weight: var(--weight-semibold);
    letter-spacing: var(--tracking-widest);
    text-transform: uppercase;
    color: var(--fg-dim);
  }

  .lede strong {
    color: var(--fg);
    font-weight: var(--weight-medium);
  }
</style>
